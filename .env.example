# Muster configuration.
#
# Copy to .env. Everything here is optional: with an empty file the app runs on
# demo data and the deterministic layout, which is already a complete demo.
#
# Nothing is VITE_ prefixed, and that is deliberate. Vite inlines every VITE_
# variable into the JavaScript bundle, so a token named that way is published to
# anyone who opens devtools on the deployed site. These are read server side and
# never reach the browser.


# ── The model ───────────────────────────────────────────────────────────────
# Without this the app falls back to a hand written layout. It still looks
# right, but nothing is being composed, which is the whole point of the project.
# Any OpenAI compatible /chat/completions endpoint works.

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini


# ── Cookie secret ───────────────────────────────────────────────────────────
# Encrypts the cookie holding a visitor's own connected accounts. There is a
# development default in the source, which is public, so ANY DEPLOYMENT MUST SET
# THIS or visitor connections are encrypted with a key everyone can read.
#   openssl rand -base64 32

SESSION_SECRET=


# ── GitHub ──────────────────────────────────────────────────────────────────
# Reached over MCP at api.githubcopilot.com/mcp/, which accepts a PAT directly,
# with the REST API kept underneath as a fallback. Both use this one token.
#
# A fine grained PAT with read access to the repos below is enough. Add
# "Pull requests: read and write" only if you want the comment write path.

GITHUB_TOKEN=
GITHUB_REPOS=owner/repo,owner/other

# Only if you are pointing at a different MCP server.
# GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/


# ── Notion ──────────────────────────────────────────────────────────────────
# Preferred path is MCP. Notion refuses a static key on its MCP endpoint, so it
# runs on OAuth, but there is no developer console step: the server supports
# Dynamic Client Registration. Authorise once with
#
#   node scripts/mcp-auth.mjs notion
#
# and paste the lines it prints below. The server refreshes its own access
# tokens after that, so a visitor never meets a consent screen. The script also
# prints the tool list the server exposes, which is worth a look.

NOTION_MCP_CLIENT_ID=
NOTION_MCP_CLIENT_SECRET=
NOTION_MCP_REFRESH_TOKEN=

# Fallback only, used if the MCP path is not authorised. An internal integration
# token from notion.so/my-integrations. Pages must be shared with the
# integration or search comes back empty.
NOTION_TOKEN=


# ── Linear ──────────────────────────────────────────────────────────────────
# Same shape as Notion.
#
#   node scripts/mcp-auth.mjs linear

LINEAR_MCP_CLIENT_ID=
LINEAR_MCP_CLIENT_SECRET=
LINEAR_MCP_REFRESH_TOKEN=

# Fallback only. Personal API key from Settings > API. Sent without a Bearer
# prefix, which is the usual reason a valid key reads as unauthorized.
LINEAR_API_KEY=


# ── Gmail and Calendar ──────────────────────────────────────────────────────
# The one pair that cannot use MCP. Google will not let an unverified app with
# Gmail scopes serve arbitrary users, and verification takes days, so there is
# no sign in button. You authorise once and the refresh token lives here.
#
#   1. console.cloud.google.com, new project
#   2. Enable "Gmail API" and "Google Calendar API"
#   3. OAuth consent screen: External, add yourself under Test users
#   4. Credentials > OAuth client ID > Web application
#   5. Authorised redirect URI: http://localhost:5273/callback
#   6. Fill in the two below, then: node scripts/google-auth.mjs

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
