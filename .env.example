# Server side only. None of these are VITE_ prefixed, which matters: Vite inlines
# every VITE_ variable into the JavaScript bundle, so a token named that way is
# published to anyone who opens devtools on the deployed site.

# GitHub. A fine-grained PAT with read access to the repos below is enough.
# Add "Pull requests: read and write" only if you want the comment write path.
GITHUB_TOKEN=
GITHUB_REPOS=owner/repo,owner/other
# Override only if you are pointing at a different MCP server
# GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# Linear. Personal API key from Settings > API. Sent without a Bearer prefix.
LINEAR_API_KEY=

# Notion. Internal integration token from notion.so/my-integrations.
# Pages must be shared with the integration or search returns nothing.
NOTION_TOKEN=

# The model that composes the layout. Any OpenAI compatible endpoint works.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Gmail and Calendar. Google will not let an unverified app with Gmail scopes
# serve arbitrary users, so there is no sign-in button. Authorise once with
#   node scripts/google-auth.mjs
# and keep the refresh token here. Visitors then see real data having clicked
# nothing, which is the point when a judge is testing a deployed link.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Notion and Linear over MCP. Both refuse a static API key on their MCP
# endpoints, so they run off OAuth. There is no developer console step: both
# support Dynamic Client Registration, so just run
#   node scripts/mcp-auth.mjs notion
#   node scripts/mcp-auth.mjs linear
# and paste the three lines each one prints. The server refreshes its own access
# tokens from then on, so a visitor never sees a consent screen.
NOTION_MCP_CLIENT_ID=
NOTION_MCP_CLIENT_SECRET=
NOTION_MCP_REFRESH_TOKEN=
LINEAR_MCP_CLIENT_ID=
LINEAR_MCP_CLIENT_SECRET=
LINEAR_MCP_REFRESH_TOKEN=
